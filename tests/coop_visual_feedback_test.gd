extends Node2D

func _ready() -> void:
	var zone := Node2D.new()
	add_child(zone)
	var marker := Sprite2D.new()
	zone.add_child(marker)
	var prompt := Label.new()
	prompt.position = Vector2(-130, -135)
	prompt.size = Vector2(260, 30)
	zone.add_child(prompt)
	var feedback = load("res://scripts/coop/visual_feedback.gd")
	var icon: Sprite2D = feedback.make_place_icon(zone, prompt)
	assert(icon.texture and not icon.visible)
	prompt.visible = true
	feedback.sync_place_icon(icon, prompt, true)
	assert(icon.visible, "A valid interaction displays the place icon")
	feedback.sync_place_icon(icon, prompt, false)
	assert(not icon.visible, "Wrong items must not display the place icon")
	feedback.update_marker(marker, "pillow", "active", false)
	assert(marker.visible and marker.texture.resource_path.ends_with("pillow_slot_active.png"))
	feedback.update_marker(marker, "pillow", "success", true)
	assert(not marker.visible, "A completed pillow must hide its marker")
	feedback.update_marker(marker, "store", "success", true)
	assert(marker.visible and marker.texture.resource_path.ends_with("zone_success.png"))
	var basket := Sprite2D.new()
	zone.add_child(basket)
	feedback.update_basket(basket, "active")
	assert(basket.texture.resource_path.ends_with("basket_active.png"))
	feedback.update_basket(basket, "success")
	assert(basket.texture.resource_path.ends_with("basket_idle.png"), "Never show the baked pillow for a gamepad")
	print("Co-op icons, pillow markers, and safe basket states verified.")
	get_tree().quit()
